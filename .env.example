# Backend Environment Configuration Example
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=kumarda_contacts

# Security & Session Configuration (Mandatory)
SESSION_SECRET=your_secure_random_session_secret_key_change_in_prod

# CORS Allowed Origins (Comma-separated in production)
CORS_ORIGIN=http://localhost:3000

# OpenAI Intelligence Layer (Optional - Server-side only, falls back to deterministic rule engine if empty)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Brevo Email Configuration (Optional for Password Reset OTP)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=Kumarda Contacts
