# Backend Environment Configuration Example
PORT=5000
# Set to 'production' on Hostinger/live server:
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=dossier_contacts

# Security & Session Configuration (Mandatory: Must be set to a secure secret)
SESSION_SECRET=your_secure_random_session_secret_key_change_in_prod

# CORS Allowed Origins (Comma-separated in production, e.g., https://your-app.vercel.app,https://yourdomain.com)
# Note: Do not include trailing slashes. All *.vercel.app origins are also automatically accepted.
CORS_ORIGIN=http://localhost:3000

# Google Gemini Intelligence Layer (Server-side only, falls back to deterministic rule engine if empty)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Brevo Email Configuration (Optional for Password Reset OTP)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=Dossier
