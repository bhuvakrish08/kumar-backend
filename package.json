{
  "name": "dossier-backend",
  "version": "1.0.0",
  "description": "Dossier V2 Express.js Backend API for Hostinger Node.js App Host",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node test_suite.js",
    "migrate": "node migrate_db.js",
    "db:init": "node init_db.js",
    "db:seed": "node seed_db.js",
    "db:reset": "node init_db.js && node seed_db.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.9.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
